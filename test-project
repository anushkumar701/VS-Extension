<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cobee Test Page</title>
  <link rel="stylesheet" href="test_style.css">
</head>
<body>

  <div class="card">
    <h1>🎮 Cobee Playground Test</h1>
    <p>Click the buttons below to test console output.</p>

    <div class="btn-row">
      <button id="btnLog" class="btn btn-blue">Log Array</button>
      <button id="btnWarn" class="btn btn-yellow">Warn</button>
      <button id="btnError" class="btn btn-red">Error</button>
      <button id="btnInfo" class="btn btn-green">Info</button>
    </div>

    <div class="btn-row">
      <button id="btnAlert" class="btn btn-blue">Alert</button>
      <button id="btnConfirm" class="btn btn-yellow">Confirm</button>
      <button id="btnPrompt" class="btn btn-green">Prompt</button>
    </div>

    <div class="output-box" id="output">Output will appear here...</div>
  </div>

  <script>
    const output = document.getElementById('output');

    function show(text) {
      output.textContent = text;
    }

    // ── Array output (horizontal test) ──
    document.getElementById('btnLog').addEventListener('click', () => {
      const nums = [10, 20, 30, 40, 50];
      const words = ["hello", "world", "cobee"];
      const nested = [[1, 2], [3, 4]];

      console.log("Simple array:", nums);
      console.log("String array:", words);
      console.log("Nested array:", nested);
      console.log("Mixed:", [1, "two", true, null]);
      console.log({ name: "Alice", scores: [95, 87, 92] });

      show("Logged arrays to console ✅");
    });

    document.getElementById('btnWarn').addEventListener('click', () => {
      console.warn("⚠ Low memory warning!");
      console.warn("Array in warn:", [1, 2, 3]);
      show("Warning sent ⚠");
    });

    document.getElementById('btnError').addEventListener('click', () => {
      console.error("Something went wrong!");
      // Intentional error to test error parser
      try {
        null.property;
      } catch(e) {
        console.error(e.message);
      }
      show("Error sent ✕");
    });

    document.getElementById('btnInfo').addEventListener('click', () => {
      console.info("App version: 1.0.5");
      console.info("Supported:", ["JS", "HTML", "CSS"]);
      show("Info sent ℹ");
    });

    // ── Dialog tests ──
    document.getElementById('btnAlert').addEventListener('click', () => {
      alert("Hello from Cobee!");
      show("Alert dismissed ✅");
    });

    document.getElementById('btnConfirm').addEventListener('click', () => {
      const result = confirm("Do you like Cobee?");
      console.log("Confirm result:", result);
      show("Confirm result: " + result);
    });

    document.getElementById('btnPrompt').addEventListener('click', () => {
      const name = prompt("What's your name?", "Student");
      console.log("Prompt result:", name);
      show("Hello, " + (name || "nobody") + "!");
    });

    // ── Auto-run on load ──
    console.log("✅ Page loaded!");
    console.log("DOM ready, buttons:", ["btnLog", "btnWarn", "btnError", "btnInfo"]);
  </script>

</body>
</html>
