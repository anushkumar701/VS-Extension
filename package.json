{
	"name": "js-live-preview",
	"displayName": "JS Live Preview",
	"description": "Instant side-by-side HTML & CSS Live Preview with interactive JavaScript execution and DevTools console right inside VS Code.",
	"version": "1.0.2",
	"publisher": "Midnight-Compiler",
	"license": "MIT",
	"icon": "media/logo.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/anushkumar701/VS-Extension.git"
	},
	"bugs": {
		"url": "https://github.com/anushkumar701/VS-Extension/issues"
	},
	"homepage": "https://github.com/anushkumar701/VS-Extension#readme",
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": [
		"Visualization",
		"Education",
		"Other"
	],
	"keywords": [
		"html",
		"css",
		"javascript",
		"js",
		"live preview",
		"html preview",
		"css preview",
		"javascript console",
		"js console",
		"live reload",
		"web development",
		"frontend",
		"devtools",
		"webview"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "jsLivePreview.run",
				"title": "Live Preview: Open",
				"shortTitle": "Open Live Preview",
				"icon": "$(play)"
			},
			{
				"command": "jsLivePreview.openExternal",
				"title": "Live Preview: Open in External Browser",
				"icon": "$(browser)"
			},
			{
				"command": "jsLivePreview.clear",
				"title": "Live Preview: Clear Console",
				"icon": "$(clear-all)"
			}
		],
		"keybindings": [
			{
				"command": "jsLivePreview.run",
				"key": "ctrl+shift+z",
				"mac": "cmd+shift+z",
				"when": "editorTextFocus"
			},
			{
				"command": "jsLivePreview.run",
				"key": "ctrl+shift+j",
				"mac": "cmd+shift+j",
				"when": "editorTextFocus"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "jsLivePreview.run",
					"when": "resourceLangId == javascript || resourceLangId == html || resourceLangId == typescript || resourceLangId == css",
					"group": "navigation@1"
				}
			]
		},
		"configuration": {
			"title": "JS Live Preview",
			"properties": {
				"jsLivePreview.openLocation": {
					"type": "string",
					"enum": [
						"sideBySide",
						"externalBrowser"
					],
					"default": "sideBySide",
					"description": "Choose whether Live Preview opens as a split-screen panel inside VS Code or as a separate external browser window."
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"vscode:prepublish": "echo 'Prepublish complete'",
		"test": "npm run compile && node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/glob": "^8.1.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.60.0",
		"@vscode/test-electron": "^2.5.2",
		"glob": "^13.0.6",
		"mocha": "^11.7.5",
		"typescript": "^5.3.0"
	}
}