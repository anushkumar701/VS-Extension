{
	"name": "cobee-playground",
	"license": "MIT",
	"displayName": "Cobee Playground",
	"description": "Preview + console panel for your JavaScript and HTML files. Press Run to see live output.",
	"version": "1.0.5",
	"icon": "media/logo.png",
	"publisher": "WikanAdnyana",
	"repository": {
		"type": "git",
		"url": "https://github.com/wikanadnyana/cobee-support.git"
	},
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": [
		"Education",
		"Other"
	],
	"keywords": [
		"javascript",
		"playground",
		"preview",
		"console",
		"html",
		"live"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "cobeePlayground.run",
				"title": "Cobee Playground: Run",
				"shortTitle": "Run in Playground",
				"icon": "$(play)"
			},
			{
				"command": "cobeePlayground.clear",
				"title": "Cobee Playground: Clear Console",
				"icon": "$(clear-all)"
			}
		],
		"keybindings": [
			{
				"command": "cobeePlayground.run",
				"key": "ctrl+shift+j",
				"mac": "cmd+shift+j",
				"when": "editorTextFocus"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "cobeePlayground.run",
					"when": "resourceLangId == javascript || resourceLangId == html || resourceLangId == typescript",
					"group": "navigation@1"
				}
			]
		}
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"vscode:prepublish": "npm run compile",
		"test": "npm run compile && node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/glob": "^8.1.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.60.0",
		"@vscode/test-electron": "^2.5.2",
		"glob": "^13.0.6",
		"mocha": "^11.7.5",
		"typescript": "^5.3.0"
	},
	"__metadata": {
		"installedTimestamp": 1785222537341,
		"targetPlatform": "undefined",
		"size": 186539
	}
}